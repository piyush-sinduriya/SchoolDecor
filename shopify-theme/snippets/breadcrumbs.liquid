{%- unless template == 'index' or template == 'cart' or template == '404' -%}
  <nav class="sd-breadcrumbs" aria-label="Breadcrumb">
    <ol class="sd-breadcrumbs__list">
      <li>
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      </li>
      {%- if template.name == 'collection' and collection -%}
        {%- if current_tags -%}
          <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
          <li aria-current="page">{{ current_tags | join: ' + ' }}</li>
        {%- else -%}
          <li aria-current="page">{{ collection.title }}</li>
        {%- endif -%}
      {%- elsif template.name == 'product' -%}
        {%- if collection -%}
          <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">Catalog</a></li>
        {%- endif -%}
        <li aria-current="page">{{ product.title }}</li>
      {%- elsif template.name == 'article' -%}
        <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
        <li aria-current="page">{{ article.title }}</li>
      {%- elsif template.name == 'blog' -%}
        <li aria-current="page">{{ blog.title }}</li>
      {%- elsif template.name == 'page' -%}
        <li aria-current="page">{{ page.title }}</li>
      {%- elsif template.name == 'list-collections' -%}
        <li aria-current="page">{{ 'collections.general.all_collections' | t }}</li>
      {%- elsif template.name == 'search' -%}
        <li aria-current="page">Search</li>
      {%- endif -%}
    </ol>
  </nav>
{%- endunless -%}
