<section class="sd-section sd-section-pad" style="--sd-pad-y: 64px;">
  <div class="sd-container">
    {% render 'breadcrumbs' %}
    <div class="sd-split">
      <div class="sd-split__media" data-sd-reveal>
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="eager">
        {%- else -%}
          <img src="{{ 'sd-school-library.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="eager">
        {%- endif -%}
      </div>
      <div class="sd-split__content" data-sd-reveal>
        <p class="sd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1 class="sd-heading sd-heading--xl">{{ section.settings.heading | escape }}</h1>
        <div class="sd-prose">{{ section.settings.intro_text }}</div>
        {%- if page.content != blank -%}
          <div class="sd-prose">{{ page.content }}</div>
        {%- endif -%}
        <div class="sd-split__actions">
          <a href="/collections" class="sd-btn sd-btn--primary">Explore Collections</a>
          <button type="button" class="sd-btn sd-btn--outline" data-open-quote>Request a Quote</button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Us Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "About Hero Photograph"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Lead-in Text",
      "default": "About School Decor"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Designing Functional, Inspiring Educational Spaces"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Brand Story",
      "default": "<p>School Decor brings together ergonomic classroom furniture, early-years Montessori environments, active soft play zones, science and STEM laboratories, outdoor play parks and specialized campus flooring.</p><p>We work closely with school founders, principals, architects and educators to tailor layouts and equipment to every age group and institutional space.</p>"
    }
  ]
}
{% endschema %}
