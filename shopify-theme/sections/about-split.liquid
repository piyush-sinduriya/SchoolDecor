<section
  class="sd-section sd-section-pad"
  style="--sd-section-bg: {{ section.settings.bg_color | default: '#FFFFFF' }}; --sd-pad-y: {{ section.settings.padding_y | default: 80 }}px;"
>
  <div class="sd-container">
    <div class="sd-split{% if section.settings.image_position == 'right' %} sd-split--reverse{% endif %}">
      <div class="sd-split__media" data-sd-reveal>
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {%- else -%}
          <img src="{{ 'sd-school-library.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- endif -%}
      </div>

      <div class="sd-split__content" data-sd-reveal style="--sd-stagger: 1;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="sd-heading">{{ section.settings.heading | escape }}</h2>
        <div class="sd-prose">
          {{ section.settings.body_text }}
        </div>
        {%- if section.settings.button_label != blank -%}
          <div class="sd-split__actions">
            <a href="{{ section.settings.button_link | default: '/pages/about-us' }}" class="sd-btn sd-btn--primary">
              {{ section.settings.button_label | escape }}
              {% render 'icon', name: 'arrow-right' %}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About School Decor Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle School Interior Photo"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Placement",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Lead-in Text",
      "default": "About School Decor"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Creating Inspiring Learning Environments"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Story Text",
      "default": "<p>School Decor partners with preschools, K-12 campuses and educational institutions to supply thoughtfully crafted furniture, active play zones, science and STEM laboratories, outdoor playground structures and specialized school flooring.</p><p>From early childhood Montessori rooms to senior collaborative classrooms and multi-sport surfaces, every product is selected to support safety, daily durability and joyful learning.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "About Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Vertical Spacing",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "About School Decor Split"
    }
  ]
}
{% endschema %}
