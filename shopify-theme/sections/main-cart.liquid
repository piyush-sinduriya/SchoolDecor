<section class="sd-section sd-section-pad" style="--sd-pad-y: 56px;">
  <div class="sd-container">
    <h1 class="sd-heading sd-heading--xl">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="sd-empty-collection-note">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="sd-btn sd-btn--primary">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="sd-cart-page">
        <div class="sd-cart-page__items">
          {%- for item in cart.items -%}
            <div class="sd-cart-item">
              <a href="{{ item.url }}" class="sd-cart-item__img">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" loading="lazy">
                {%- endif -%}
              </a>
              <div class="sd-cart-item__details">
                <a href="{{ item.url }}" class="sd-cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="sd-cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="sd-cart-item__price">{{ item.final_line_price | money }}</p>
                <div class="sd-cart-item__controls">
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.title | escape }}" class="sd-qty-input">
                  <a href="{{ item.url_to_remove }}" class="sd-text-link">{{ 'cart.general.remove' | t }}</a>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="sd-cart-page__summary">
          <div class="sd-cart-subtotal">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="sd-cart-tax-note">{{ 'cart.general.taxes_shipping_note' | t }}</p>
          <div class="sd-cart-page__btns">
            <button type="submit" name="update" class="sd-btn sd-btn--outline sd-btn--full">Update Cart</button>
            <button type="submit" name="checkout" class="sd-btn sd-btn--primary sd-btn--full">{{ 'cart.general.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
