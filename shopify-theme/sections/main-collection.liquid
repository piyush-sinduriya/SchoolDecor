{%- liquid
  assign wa_num = settings.whatsapp_number | default: '919312254660' | remove: '+' | remove: ' ' | remove: '-'
  assign wa_msg = 'Hello School Decor team, I would like to enquire about ' | append: collection.title | append: ' (' | append: request.origin | append: collection.url | append: ')'
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<section class="sd-collection-banner">
  <div class="sd-container">
    {% render 'breadcrumbs' %}
    <div class="sd-collection-banner__grid">
      <div class="sd-collection-banner__copy">
        <h1 class="sd-heading sd-heading--xl">{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}
          <div class="sd-prose">{{ collection.description }}</div>
        {%- else -%}
          <p class="sd-subtext">Explore School Decor's {{ collection.title | escape }} range crafted for modern classrooms, activity rooms and institutional spaces.</p>
        {%- endif -%}
        <div class="sd-collection-banner__actions">
          <button type="button" class="sd-btn sd-btn--primary" data-open-quote data-product-title="{{ collection.title | escape }}">
            Request Collection Quote
          </button>
          <a href="https://wa.me/{{ wa_num }}?text={{ wa_msg | url_encode }}" target="_blank" rel="noopener noreferrer" class="sd-btn sd-btn--outline">
            {% render 'icon', name: 'whatsapp' %}
            <span>WhatsApp Enquiry</span>
          </a>
        </div>
      </div>
      {%- if collection.image != blank -%}
        <div class="sd-collection-banner__media">
          <img src="{{ collection.image | image_url: width: 960 }}" alt="{{ collection.title | escape }}" loading="eager">
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="sd-section sd-section-pad" style="--sd-pad-y: 48px;" data-collection-page>
  <div class="sd-container">
    <div class="sd-collection-toolbar">
      <div class="sd-collection-toolbar__left">
        <button type="button" class="sd-btn sd-btn--outline sd-btn--sm sd-mobile-filter-btn" data-toggle-filters>
          {% render 'icon', name: 'filter' %}
          <span>{{ 'collections.general.filter_and_sort' | t }}</span>
        </button>
        <p class="sd-collection-count" data-collection-count>
          {{ 'collections.general.product_count' | t: count: collection.products_count }}
        </p>
      </div>

      <div class="sd-collection-toolbar__right">
        <label for="sd-sort-select" class="sd-visually-hidden">{{ 'collections.general.sort_by' | t }}</label>
        <select id="sd-sort-select" name="sort_by" class="sd-select" data-collection-sort>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected="selected"{% endif %}>
              {{ option.name | escape }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    <div class="sd-collection-layout">
      {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
        <aside class="sd-filters-sidebar" id="sd-filters-sidebar" aria-label="Product Filters">
          <div class="sd-filters-sidebar__head">
            <h2>Filters</h2>
            <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="sd-text-link">{{ 'collections.general.clear_all' | t }}</a>
          </div>
          <form id="sd-collection-filters-form" class="sd-filters-form" method="get" action="{{ collection.url }}">
            <input type="hidden" name="sort_by" value="{{ sort_by }}">
            {%- for filter in collection.filters -%}
              <details class="sd-filter-group" open>
                <summary class="sd-filter-group__title">
                  <span>{{ filter.label | escape }}</span>
                  {% render 'icon', name: 'chevron-down' %}
                </summary>
                <div class="sd-filter-group__body">
                  {%- case filter.type -%}
                    {%- when 'boolean' or 'list' -%}
                      <ul class="sd-filter-list">
                        {%- for filter_value in filter.values -%}
                          <li>
                            <label class="sd-checkbox">
                              <input
                                type="checkbox"
                                name="{{ filter_value.param_name }}"
                                value="{{ filter_value.value }}"
                                {% if filter_value.active %}checked{% endif %}
                                {% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
                                onchange="this.form.submit()"
                              >
                              <span>{{ filter_value.label | escape }} ({{ filter_value.count }})</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- when 'price_range' -%}
                      <div class="sd-price-range">
                        <div class="sd-field">
                          <label for="Filter-{{ filter.label | escape }}-GTE">Min ({{ cart.currency.symbol }})</label>
                          <input
                            id="Filter-{{ filter.label | escape }}-GTE"
                            name="{{ filter.min_value.param_name }}"
                            type="number"
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                            placeholder="0"
                          >
                        </div>
                        <div class="sd-field">
                          <label for="Filter-{{ filter.label | escape }}-LTE">Max ({{ cart.currency.symbol }})</label>
                          <input
                            id="Filter-{{ filter.label | escape }}-LTE"
                            name="{{ filter.max_value.param_name }}"
                            type="number"
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                            placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          >
                        </div>
                        <button type="submit" class="sd-btn sd-btn--outline sd-btn--sm sd-btn--full">
                          {{ 'collections.general.apply' | t }}
                        </button>
                      </div>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
          </form>
        </aside>
      {%- endif -%}

      <div class="sd-collection-main">
        {% paginate collection.products by section.settings.products_per_page %}
          {%- if collection.products.size > 0 -%}
            <div class="sd-product-grid sd-cols--{{ section.settings.columns_desktop | default: 3 }}">
              {%- for product in collection.products -%}
                {% render 'product-card', card_product: product, collection: collection %}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <nav class="sd-pagination" aria-label="Pagination">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="sd-btn sd-btn--outline sd-btn--sm">Previous</a>
                {%- endif -%}
                <span class="sd-pagination__info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="sd-btn sd-btn--outline sd-btn--sm">Next</a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- else -%}
            <div class="sd-empty-collection-note">
              <p>{{ 'collections.general.empty' | t }}</p>
              <a href="{{ collection.url }}" class="sd-btn sd-btn--outline">{{ 'collections.general.clear_all' | t }}</a>
            </div>
          {%- endif -%}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid & Filters",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products Per Page",
      "default": 16
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Grid Columns",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable Native Storefront Filters",
      "default": true,
      "info": "Configure Price, Availability and Product Type filters in Shopify Search & Discovery app."
    }
  ]
}
{% endschema %}
