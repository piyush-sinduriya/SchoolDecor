<section class="sd-section sd-section-pad sd-campus-map-sec" data-campus-map-section data-maps-key="{{ section.settings.google_maps_api_key | escape }}" style="--sd-section-bg: {{ section.settings.bg_color }}; --sd-pad-y: {{ section.settings.padding_y }}px;">
  <div class="sd-container">
    <div class="sd-section__header sd-section__header--split" data-sd-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="sd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="sd-heading sd-heading--lg">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_script != blank -%}
            <span class="sd-hero__script sd-hero__script--dark">{{ section.settings.heading_script | escape }}</span>
          {%- endif -%}
        </h2>
        {%- if section.settings.description != blank -%}
          <p class="sd-subtext">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
      <button type="button" class="sd-btn sd-btn--outline sd-btn--sm" data-open-quote data-product-title="Showroom & Factory Visit Request">
        Schedule Visit
      </button>
    </div>

    <div class="sd-campus-map-grid" data-sd-reveal>
      <div class="sd-hub-list" role="tablist" aria-label="School Decor Head Office, Factory & Regional Hubs">
        {%- for block in section.blocks -%}
          <button
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            class="sd-hub-card {% if forloop.first %}is-active{% endif %}"
            data-hub-trigger
            data-hub-city="{{ block.settings.city | escape }}"
            data-hub-title="{{ block.settings.title | escape }}"
            data-hub-address="{{ block.settings.address | escape }}"
            data-hub-hours="{{ block.settings.hours | escape }}"
            data-hub-lat="{{ block.settings.lat | escape }}"
            data-hub-lng="{{ block.settings.lng | escape }}"
            {{ block.shopify_attributes }}
          >
            <p class="sd-hub-card__region">{{ block.settings.region | escape }}</p>
            <h3 class="sd-hub-card__city">{{ block.settings.city | escape }}</h3>
            <p class="sd-hub-card__addr">{{ block.settings.address | escape }}</p>
            <p class="sd-hub-card__hours">{{ block.settings.hours | escape }}</p>
          </button>
        {%- endfor -%}
      </div>

      <div class="sd-map-frame">
        <div class="sd-map-viewport" data-campus-map-canvas aria-label="School Decor Head Office & Factory Map">
          <iframe
            data-map-embed-iframe
            title="School Decor Head Office & Factory Google Map"
            src="https://maps.google.com/maps?q=School+Decor,+1%2F26A,+Lalita+Park,+Laxmi+Nagar,+New+Delhi,+Delhi+110092&t=&z=15&ie=UTF8&iwloc=&output=embed"
            style="width:100%;height:100%;min-height:420px;border:0;display:block;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Head Office & Factory Map",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Head Office, Manufacturing Factory & Regional Hubs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit School Decor" },
    { "type": "text", "id": "heading_script", "label": "Script Accent Word", "default": "Showroom & Factory" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Inspect our 18mm FSC birch joinery, Montessori learning materials, and K-12 classroom furniture at our Laxmi Nagar, New Delhi Head Office, our Delhi NCR Manufacturing Factory, or our regional hubs." },
    { "type": "text", "id": "google_maps_api_key", "label": "Google Maps API Key (Optional)" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_y", "min": 32, "max": 112, "step": 4, "unit": "px", "label": "Vertical Padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "hub",
      "name": "Regional Hub",
      "settings": [
        { "type": "text", "id": "region", "label": "Zone Label", "default": "Registered Head Office & Showroom" },
        { "type": "text", "id": "city", "label": "City", "default": "Laxmi Nagar, New Delhi" },
        { "type": "text", "id": "title", "label": "Hub Title", "default": "School Decor — Head Office & Experience Center (Lalita Park)" },
        { "type": "text", "id": "address", "label": "Address", "default": "No. 1/26A, 2nd Floor, Lalita Park (Near Gurudwara, Opp. Metro Pillar No. 24, Vikas Marg), Laxmi Nagar, New Delhi - 110092" },
        { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Sat · 9:30 AM – 7:00 PM" },
        { "type": "text", "id": "lat", "label": "Latitude", "default": "28.6304" },
        { "type": "text", "id": "lng", "label": "Longitude", "default": "77.2773" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Head Office & Factory Map",
      "blocks": [
        { "type": "hub", "settings": { "region": "Registered Head Office & Showroom", "city": "Laxmi Nagar, New Delhi", "title": "School Decor — Head Office & Experience Center (Lalita Park)", "address": "No. 1/26A, 2nd Floor, Lalita Park (Near Gurudwara, Opp. Metro Pillar No. 24, Vikas Marg), Laxmi Nagar, New Delhi - 110092", "hours": "Mon–Sat · 9:30 AM – 7:00 PM", "lat": "28.6304", "lng": "77.2773" } },
        { "type": "hub", "settings": { "region": "School Decor Factory & Production Works", "city": "Delhi NCR (Factory Unit)", "title": "School Decor Manufacturing Factory & Dispatch Hub", "address": "School Decor Manufacturing & Industrial Works, Bawana–Patparganj Industrial Corridor, New Delhi - 110039", "hours": "Mon–Sat · 9:00 AM – 6:30 PM", "lat": "28.7982", "lng": "77.0462" } },
        { "type": "hub", "settings": { "region": "West India Hub", "city": "Mumbai", "title": "Early-Years & Sensory Architecture Center", "address": "Lower Parel Institutional Corridor, Mumbai, Maharashtra 400013", "hours": "Mon–Sat · 10:00 AM – 6:30 PM", "lat": "18.9953", "lng": "72.8295" } },
        { "type": "hub", "settings": { "region": "South India Hub", "city": "Bengaluru", "title": "STEM, Robotics & Modular Classroom Studio", "address": "Indiranagar Institutional Design District, Bengaluru, Karnataka 560038", "hours": "Mon–Sat · 9:30 AM – 6:30 PM", "lat": "12.9784", "lng": "77.6408" } },
        { "type": "hub", "settings": { "region": "Deccan Hub", "city": "Hyderabad", "title": "Turnkey K-12 Campus Logistics & Lounge", "address": "Jubilee Hills Road No. 36, Hyderabad, Telangana 500033", "hours": "Mon–Sat · 10:00 AM – 6:00 PM", "lat": "17.4326", "lng": "78.4071" } },
        { "type": "hub", "settings": { "region": "Timber & Craft Hub", "city": "Jaipur", "title": "FSC Birch Woodwork & Finishing Facility", "address": "Sitapura Institutional Craft Zone, Jaipur, Rajasthan 302022", "hours": "Mon–Sat · 9:00 AM – 5:30 PM", "lat": "26.7769", "lng": "75.8473" } }
      ]
    }
  ]
}
{% endschema %}
