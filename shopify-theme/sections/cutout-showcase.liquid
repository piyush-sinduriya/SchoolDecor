<section
  id="section-{{ section.id }}"
  class="sd-section sd-section-pad sd-cutout-section{% if section.settings.enable_color_stage %} is-stage-active{% endif %}"
  style="--sd-section-bg: {{ section.settings.bg_color | default: '#EAF6EF' }}; --sd-pad-y: {{ section.settings.padding_y | default: 72 }}px;"
  data-cutout-stage-section
>
  <div class="sd-container">
    {%- if section.settings.enable_color_stage and section.blocks.size > 0 -%}
      {%- assign first_b = section.blocks.first -%}
      {%- liquid
        assign first_img = 'sd-cutout-student-desk.png' | asset_url
        if first_b.settings.image != blank
          assign first_img = first_b.settings.image | image_url: width: 900
        elsif first_b.settings.product.featured_image != blank
          assign first_img = first_b.settings.product.featured_image | image_url: width: 900
        elsif first_b.settings.fallback_asset != blank
          assign first_img = first_b.settings.fallback_asset | asset_url
        endif
      -%}
      <div class="sd-stage-tabs" role="tablist" aria-label="Product stage switcher">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b_img = 'sd-cutout-student-desk.png' | asset_url
            if block.settings.image != blank
              assign b_img = block.settings.image | image_url: width: 900
            elsif block.settings.product.featured_image != blank
              assign b_img = block.settings.product.featured_image | image_url: width: 900
            elsif block.settings.fallback_asset != blank
              assign b_img = block.settings.fallback_asset | asset_url
            endif
            assign b_url = block.settings.product.url | default: block.settings.collection.url | default: block.settings.custom_url | default: '/collections'
            assign b_title = block.settings.title | default: block.settings.product.title | default: 'Featured Product'
          -%}
          <button
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            class="sd-stage-tab{% if forloop.first %} is-active{% endif %}"
            data-stage-tab="{{ forloop.index0 }}"
            data-stage-bg="{{ block.settings.stage_bg | default: '#EAF6EF' }}"
            data-stage-script="{{ block.settings.script_tag | default: block.settings.category | escape }}"
            data-stage-title="{{ b_title | escape }}"
            data-stage-price="{{ block.settings.price_label | default: 'Available for Order' | escape }}"
            data-stage-dims="{{ block.settings.dimensions | default: 'Institutional Sizing' | escape }}"
            data-stage-age="{{ block.settings.age_group | default: 'K-12 & Preschool' | escape }}"
            data-stage-mat="{{ block.settings.materials | default: 'Birchwood & Steel' | escape }}"
            data-stage-img="{{ b_img }}"
            data-stage-url="{{ b_url }}"
          >
            {{ block.settings.short_label | default: b_title | escape }}
          </button>
        {%- endfor -%}
      </div>

      <div class="sd-stage-hero">
        <div class="sd-stage-hero__copy">
          <p class="sd-script-lead sd-stage-hero__script" data-stage-out-script>
            {{ first_b.settings.script_tag | default: first_b.settings.category | escape }}
          </p>
          <h2 class="sd-stage-hero__title" data-stage-out-title>
            {{ first_b.settings.title | default: first_b.settings.product.title | escape }}
          </h2>
          <div class="sd-stage-specs">
            <div class="sd-stage-spec">
              <span>Dimensions</span>
              <strong data-stage-out-dims>{{ first_b.settings.dimensions | default: '600 × 450 × 640–760 mm' | escape }}</strong>
            </div>
            <div class="sd-stage-spec">
              <span>Age Wing</span>
              <strong data-stage-out-age>{{ first_b.settings.age_group | default: 'Grades 1–12' | escape }}</strong>
            </div>
            <div class="sd-stage-spec">
              <span>Materials</span>
              <strong data-stage-out-mat>{{ first_b.settings.materials | default: '18mm Birch + Steel' | escape }}</strong>
            </div>
          </div>
          <p class="sd-stage-hero__price" data-stage-out-price>
            {{ first_b.settings.price_label | default: 'Available for Order' | escape }}
          </p>
          <a
            href="{{ first_b.settings.product.url | default: first_b.settings.collection.url | default: first_b.settings.custom_url | default: '/collections' }}"
            class="sd-btn sd-btn--primary sd-btn--lg"
            data-stage-out-link
          >
            Inspect Product {% render 'icon', name: 'arrow-right' %}
          </a>
        </div>
        <div class="sd-stage-hero__media">
          <div class="sd-stage-hero__glow" aria-hidden="true"></div>
          <div class="sd-stage-hero__orbit" aria-hidden="true"></div>
          <img
            src="{{ first_img }}"
            alt="{{ first_b.settings.title | escape }}"
            class="sd-stage-hero__img sd-cutout-sticker"
            data-stage-out-img
          >
        </div>
      </div>
    {%- endif -%}

    <div class="sd-section__header-row" data-sd-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="sd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="sd-heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="sd-subtext">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '/collections' }}" class="sd-btn sd-btn--dark">
          {{ section.settings.button_label | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <div class="sd-cutout-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign target_url = block.settings.product.url | default: block.settings.collection.url | default: block.settings.custom_url | default: '/collections'
          assign card_title = block.settings.title | default: block.settings.product.title | default: 'Featured Product'
          assign modulo = forloop.index0 | modulo: 2
          if modulo == 0
            assign parallax_amt = -14
          else
            assign parallax_amt = 14
          endif
        -%}
        <div
          class="sd-cutout-parallax-col"
          {% if section.settings.enable_scroll_parallax %}data-sd-parallax="{{ parallax_amt }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          <a
            href="{{ target_url }}"
            class="sd-cutout-card"
            data-sd-reveal
            style="--sd-stagger: {{ forloop.index0 }}; --sd-cutout-bar: {{ block.settings.bar_color | default: '#00A048' }};"
          >
            <div class="sd-cutout-card__stage" style="background-color: {{ block.settings.tint_color | default: '#EAF7EF' }};">
              {%- if block.settings.age_group != blank -%}
                <span class="sd-cutout-card__age">{{ block.settings.age_group | escape }}</span>
              {%- endif -%}
              <div class="sd-cutout-card__shadow" aria-hidden="true"></div>
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  class="sd-cutout-card__img"
                >
              {%- elsif block.settings.product.featured_image != blank -%}
                <img
                  src="{{ block.settings.product.featured_image | image_url: width: 800 }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  class="sd-cutout-card__img"
                >
              {%- else -%}
                {%- assign fallback_png = block.settings.fallback_asset | default: 'sd-cutout-student-desk.png' -%}
                <img
                  src="{{ fallback_png | asset_url }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  class="sd-cutout-card__img"
                >
              {%- endif -%}
            </div>

            <div class="sd-cutout-card__body">
              {%- if block.settings.category != blank -%}
                <p class="sd-cutout-card__cat">{{ block.settings.category | escape }}</p>
              {%- endif -%}
              <h3 class="sd-cutout-card__title">{{ card_title | escape }}</h3>
              {%- if block.settings.spec_bullets != blank -%}
                {%- assign spec_arr = block.settings.spec_bullets | split: '|' -%}
                <ul class="sd-cutout-card__specs">
                  {%- for sp in spec_arr limit: 2 -%}
                    <li>{{ sp | strip | escape }}</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <div class="sd-cutout-card__footer">
                <span class="sd-cutout-card__price">
                  {%- if block.settings.product != blank and block.settings.product.price > 0 -%}
                    {{ block.settings.product.price | money }}
                  {%- elsif block.settings.price_label != blank -%}
                    {{ block.settings.price_label | escape }}
                  {%- else -%}
                    Request a Quote
                  {%- endif -%}
                </span>
                <span class="sd-cutout-card__cta">
                  Inspect {% render 'icon', name: 'arrow-right' %}
                </span>
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cutout Product Showcase",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_color_stage",
      "label": "Enable Color-Shifting Interactive Stage",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small Lead-in Text",
      "default": "Studio Cutout Series"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Signature Floating Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Studio-isolated product highlights crafted from durable birch plywood, medical-grade soft foam, and laboratory phenolic surfaces."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Header Button Label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Header Button Link"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_parallax",
      "label": "Enable Alternating Scroll Parallax Motion",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Initial Section Background",
      "default": "#EAF6EF"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 28,
      "max": 112,
      "step": 4,
      "unit": "px",
      "label": "Vertical Spacing",
      "default": 68
    }
  ],
  "blocks": [
    {
      "type": "cutout_card",
      "name": "Floating Cutout Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Transparent PNG Cutout Image"
        },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Default Cutout PNG (When No Custom Image Uploaded)",
          "options": [
            { "value": "sd-cutout-student-desk.png", "label": "Ergonomic Birch & Steel Desk Set" },
            { "value": "sd-cutout-montessori-shelf.png", "label": "Curved Montessori Birch Activity Unit" },
            { "value": "sd-cutout-soft-play-climber.png", "label": "Modular Soft-Play Foam Climber Set" },
            { "value": "sd-cutout-science-lab-bench.png", "label": "Chemistry & STEM Island Workbench" }
          ],
          "default": "sd-cutout-student-desk.png"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Linked Shopify Product (Optional)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Linked Shopify Collection (Fallback)"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom Link URL"
        },
        {
          "type": "text",
          "id": "short_label",
          "label": "Stage Tab Label",
          "default": "Student Desk"
        },
        {
          "type": "text",
          "id": "script_tag",
          "label": "Handwritten Stage Note",
          "default": "posture-tuned"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category Label",
          "default": "School Furniture"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Ergonomic Birch & Steel Desk Set"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Fallback Price / Note",
          "default": "Available for Order"
        },
        {
          "type": "text",
          "id": "dimensions",
          "label": "Dimensions Spec",
          "default": "600 × 450 × 640–760 mm"
        },
        {
          "type": "text",
          "id": "age_group",
          "label": "Age Wing Label",
          "default": "Grades 1–12"
        },
        {
          "type": "text",
          "id": "materials",
          "label": "Core Materials",
          "default": "18mm Birch + 1.6mm Steel"
        },
        {
          "type": "text",
          "id": "spec_bullets",
          "label": "Key Spec Bullets (Separate with |)",
          "default": "Waterfall front comfort curve | Under-desk steel book tray"
        },
        {
          "type": "color",
          "id": "stage_bg",
          "label": "Interactive Stage Background",
          "default": "#EAF6EF"
        },
        {
          "type": "color",
          "id": "tint_color",
          "label": "Pedestal Tint Color",
          "default": "#EAF7EF"
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bottom Accent Bar Color",
          "default": "#00A048"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cutout Product Showcase",
      "blocks": [
        { "type": "cutout_card" },
        { "type": "cutout_card" },
        { "type": "cutout_card" },
        { "type": "cutout_card" }
      ]
    }
  ]
}
{% endschema %}
