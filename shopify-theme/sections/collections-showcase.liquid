<section
  class="sd-section sd-section-pad"
  style="--sd-section-bg: {{ section.settings.bg_color | default: '#FFFFFF' }}; --sd-pad-y: {{ section.settings.padding_y | default: 72 }}px;"
>
  <div class="sd-container">
    <div class="sd-section__header sd-align--{{ section.settings.text_alignment }}" data-sd-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="sd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="sd-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="sd-subtext">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="sd-collections-grid sd-cols--{{ section.settings.columns_desktop | default: 4 }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign linked_collection = block.settings.collection
          assign card_title = block.settings.title | default: linked_collection.title | default: 'Collection'
          assign card_url = block.settings.custom_url | default: linked_collection.url | default: '/collections'
          assign card_img = block.settings.image | default: linked_collection.featured_image
        -%}
        <a href="{{ card_url }}" class="sd-collection-card" data-sd-reveal style="--sd-stagger: {{ forloop.index0 | modulo: 4 }};" {{ block.shopify_attributes }}>
          <div class="sd-collection-card__media">
            {%- if card_img != blank -%}
              <img
                src="{{ card_img | image_url: width: 720 }}"
                alt="{{ card_title | escape }}"
                loading="lazy"
                width="{{ card_img.width }}"
                height="{{ card_img.height }}"
              >
            {%- else -%}
              <img
                src="{{ 'sd-hero-classroom.jpg' | asset_url }}"
                alt="{{ card_title | escape }}"
                loading="lazy"
              >
            {%- endif -%}
            <div class="sd-collection-card__scrim"></div>
            {%- if block.settings.tag != blank -%}
              <span class="sd-collection-card__tag">{{ block.settings.tag | escape }}</span>
            {%- endif -%}
          </div>
          <div class="sd-collection-card__content">
            <h3 class="sd-collection-card__title">{{ card_title | escape }}</h3>
            {%- if block.settings.subtitle != blank -%}
              <p class="sd-collection-card__subtitle">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
            <span class="sd-collection-card__cta">
              {{ block.settings.cta_label | default: 'Explore' }}
              {% render 'icon', name: 'arrow-right' %}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Explore Our Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Lead-in Text",
      "default": "Product Universe"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Purpose-built learning environments across early years, K-12 classrooms, laboratories, active play and outdoor campuses."
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 32,
      "max": 112,
      "step": 4,
      "unit": "px",
      "label": "Vertical Spacing",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Shopify Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override Title (Optional)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Category Wing Badge (Optional)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Short Wing/Grade Subtitle (Optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image (Optional)"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom Link Override (Optional)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button Label",
          "default": "Explore"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Explore Our Collections",
      "blocks": [
        { "type": "collection_card", "settings": { "title": "School Furniture", "custom_url": "/collections/senior" } },
        { "type": "collection_card", "settings": { "title": "Kindergarten Furniture", "custom_url": "/collections/kindergarten-furniture" } },
        { "type": "collection_card", "settings": { "title": "Preschool Furniture", "custom_url": "/collections/day-care" } },
        { "type": "collection_card", "settings": { "title": "Montessori Materials", "custom_url": "/collections/montessori-material" } },
        { "type": "collection_card", "settings": { "title": "Active Play Equipment", "custom_url": "/collections/soft-play-zones" } },
        { "type": "collection_card", "settings": { "title": "Sensory Rooms", "custom_url": "/collections/sensory-room" } },
        { "type": "collection_card", "settings": { "title": "Science Laboratories", "custom_url": "/collections/science-lab" } },
        { "type": "collection_card", "settings": { "title": "Computer Laboratories", "custom_url": "/collections/computer-lab" } },
        { "type": "collection_card", "settings": { "title": "Art Laboratories", "custom_url": "/collections/art-lab" } },
        { "type": "collection_card", "settings": { "title": "STEM Learning", "custom_url": "/collections/stem-lab" } },
        { "type": "collection_card", "settings": { "title": "Outdoor Play Equipment", "custom_url": "/collections/outdoor-fun-equipment" } },
        { "type": "collection_card", "settings": { "title": "School Flooring", "custom_url": "/products/squash-court" } }
      ]
    }
  ]
}
{% endschema %}
