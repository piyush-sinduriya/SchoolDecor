<section
  class="sd-section sd-section-pad"
  style="--sd-section-bg: {{ section.settings.bg_color | default: '#FFFFFF' }}; --sd-pad-y: {{ section.settings.padding_y | default: 80 }}px;"
  data-testimonial-slider
>
  <div class="sd-container">
    <div class="sd-section__header-row" data-sd-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="sd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="sd-heading">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="sd-slider-nav">
          <button type="button" class="sd-icon-btn sd-icon-btn--bordered" data-slider-prev aria-label="Previous testimonial">
            {% render 'icon', name: 'chevron-left' %}
          </button>
          <button type="button" class="sd-icon-btn sd-icon-btn--bordered" data-slider-next aria-label="Next testimonial">
            {% render 'icon', name: 'chevron-right' %}
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="sd-testimonials-track" data-slider-track>
      {%- for block in section.blocks -%}
        <blockquote class="sd-testimonial-card" data-sd-reveal style="--sd-stagger: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <p class="sd-testimonial-card__quote">“{{ block.settings.quote | escape }}”</p>
          <footer class="sd-testimonial-card__author">
            {%- if block.settings.photo != blank -%}
              <img
                src="{{ block.settings.photo | image_url: width: 120 }}"
                alt="{{ block.settings.customer_name | escape }}"
                class="sd-testimonial-card__avatar"
                loading="lazy"
                width="48"
                height="48"
              >
            {%- endif -%}
            <div>
              <cite class="sd-testimonial-card__name">{{ block.settings.customer_name | escape }}</cite>
              <span class="sd-testimonial-card__org">{{ block.settings.institution_name | escape }}</span>
            </div>
          </footer>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials Slider",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Lead-in Text",
      "default": "Institution Feedback"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Educators & School Leaders Say"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 32,
      "max": 112,
      "step": 4,
      "unit": "px",
      "label": "Vertical Spacing",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Customer Feedback",
          "default": "Placeholder testimonial: Replace with verified feedback from your school principal, director or procurement lead in the Theme Editor."
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer Name & Role",
          "default": "Principal / School Director (Editable Placeholder)"
        },
        {
          "type": "text",
          "id": "institution_name",
          "label": "Institution Name",
          "default": "Institution Name (Edit in Theme Editor)"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Optional Photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Slider",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
