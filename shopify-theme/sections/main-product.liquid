{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign quote_tag = settings.quote_only_tag | default: 'quote-only'
  assign is_quote_only = false
  if product.tags contains quote_tag or product.tags contains 'enquiry-only' or product.tags contains 'request-quote'
    assign is_quote_only = true
  endif
  if product.metafields.custom.enquiry_only == true or current_variant.price == 0
    assign is_quote_only = true
  endif

  assign allow_direct_buy = true
  if is_quote_only
    assign allow_direct_buy = false
  endif

  assign wa_num = settings.whatsapp_number | default: '919312254660' | remove: '+' | remove: ' ' | remove: '-'
  assign wa_msg = 'Hello School Decor team, I would like to enquire about: ' | append: product.title | append: ' (' | append: request.origin | append: product.url | append: ')'
-%}

<section class="sd-pdp" data-product-section data-product-handle="{{ product.handle }}" data-product-id="{{ product.id }}">
  <div class="sd-container">
    {% render 'breadcrumbs' %}

    <div class="sd-pdp__layout">
      <div class="sd-pdp__gallery" data-pdp-gallery>
        <div class="sd-pdp__main-media" data-zoom-container>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="sd-pdp__slide{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <img
                      src="{{ media | image_url: width: 1200 }}"
                      alt="{{ media.alt | default: product.title | escape }}"
                      width="{{ media.width }}"
                      height="{{ media.height }}"
                      class="sd-pdp__zoom-img"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    >
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, class: 'sd-pdp__video' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: class: 'sd-pdp__video' }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="sd-image-placeholder sd-ratio-4-3"><span>{{ product.title }}</span></div>
          {%- endif -%}

          <button type="button" class="sd-pdp__zoom-badge" data-toggle-zoom aria-label="Toggle image zoom">
            {% render 'icon', name: 'zoom' %}
            <span>Zoom</span>
          </button>
        </div>

        {%- if product.media.size > 1 -%}
          <div class="sd-pdp__thumbs" role="list">
            {%- for media in product.media -%}
              <button
                type="button"
                class="sd-pdp__thumb{% if forloop.first %} is-active{% endif %}"
                data-media-thumb="{{ media.id }}"
                aria-label="View media {{ forloop.index }}"
              >
                <img src="{{ media.preview_image | image_url: width: 200 }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="sd-pdp__info">
        {%- if product.type != blank -%}
          <p class="sd-eyebrow">{{ product.type | escape }}</p>
        {%- endif -%}
        <h1 class="sd-pdp__title">{{ product.title | escape }}</h1>

        <div class="sd-pdp__price-row" data-pdp-price>
          {%- if is_quote_only -%}
            <span class="sd-pdp__quote-price">Institutional Quotation Pricing</span>
          {%- else -%}
            <span class="sd-pdp__price">{{ current_variant.price | money }}</span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <s class="sd-pdp__compare">{{ current_variant.compare_at_price | money }}</s>
              <span class="sd-pdp__sale-label">{{ 'products.product.on_sale' | t }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        <p class="sd-pdp__availability" data-pdp-availability>
          {%- if is_quote_only -%}
            Custom Built / Institutional Order &middot; Request a Tailored Quotation
          {%- elsif current_variant.available -%}
            {{ 'products.product.in_stock' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </p>

        {%- if product.description != blank -%}
          <div class="sd-pdp__short-desc sd-prose">
            {{ product.description | strip_html | truncatewords: 45 }}
          </div>
        {%- endif -%}

        {% form 'product', product, id: 'sd-pdp-form', class: 'sd-pdp__form', novalidate: 'novalidate' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

          {%- unless product.has_only_default_variant -%}
            <div class="sd-pdp__variants">
              {%- for option in product.options_with_values -%}
                <fieldset class="sd-variant-group">
                  <legend>{{ option.name | escape }}</legend>
                  <div class="sd-variant-options">
                    {%- for value in option.values -%}
                      <label class="sd-variant-chip">
                        <input
                          type="radio"
                          name="option-{{ option.position }}"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                          data-variant-option
                        >
                        <span>{{ value | escape }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="sd-pdp__purchase-row">
            <div class="sd-qty-stepper">
              <button type="button" class="sd-qty-btn" data-pdp-qty="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
              <input type="number" name="quantity" value="1" min="1" class="sd-qty-input" id="sd-pdp-qty" aria-label="{{ 'products.product.quantity' | t }}">
              <button type="button" class="sd-qty-btn" data-pdp-qty="1" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
            </div>

            {%- if allow_direct_buy -%}
              <button
                type="submit"
                name="add"
                class="sd-btn sd-btn--primary sd-btn--lg sd-pdp__add-btn"
                {% unless current_variant.available %}disabled{% endunless %}
                data-pdp-add-btn
              >
                {%- if current_variant.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
            {%- else -%}
              <button
                type="button"
                class="sd-btn sd-btn--primary sd-btn--lg sd-pdp__add-btn"
                data-open-quote
                data-product-title="{{ product.title | escape }}"
                data-product-url="{{ request.origin }}{{ product.url }}"
              >
                {{ 'products.product.request_quote' | t }}
              </button>
            {%- endif -%}
          </div>

          {%- if allow_direct_buy and section.settings.show_dynamic_checkout -%}
            <div class="sd-pdp__dynamic-checkout">
              {{ form | payment_button }}
            </div>
          {%- endif -%}

          <div class="sd-pdp__enquiry-actions">
            {%- if allow_direct_buy -%}
              <button
                type="button"
                class="sd-btn sd-btn--outline sd-btn--full"
                data-open-quote
                data-product-title="{{ product.title | escape }}"
                data-product-url="{{ request.origin }}{{ product.url }}"
              >
                {{ 'products.product.request_quote' | t }}
              </button>
            {%- endif -%}
            <a
              href="https://wa.me/{{ wa_num }}?text={{ wa_msg | url_encode }}"
              target="_blank"
              rel="noopener noreferrer"
              class="sd-btn sd-btn--sage sd-btn--full"
            >
              {% render 'icon', name: 'whatsapp' %}
              <span>{{ 'products.product.whatsapp_enquiry' | t }}</span>
            </a>
          </div>
        {% endform %}

        <script type="application/json" id="sd-product-variants-json">
          {{ product.variants | json }}
        </script>
      </div>
    </div>

    <div class="sd-pdp__details" data-pdp-tabs>
      <div class="sd-tabs sd-tabs--underline" role="tablist">
        <button type="button" role="tab" class="sd-tab-btn is-active" aria-selected="true" data-tab-trigger="0">{{ 'products.product.description' | t }}</button>
        <button type="button" role="tab" class="sd-tab-btn" aria-selected="false" data-tab-trigger="1">{{ 'products.product.specifications' | t }}</button>
        <button type="button" role="tab" class="sd-tab-btn" aria-selected="false" data-tab-trigger="2">{{ 'products.product.features' | t }}</button>
        <button type="button" role="tab" class="sd-tab-btn" aria-selected="false" data-tab-trigger="3">{{ 'products.product.additional_info' | t }}</button>
      </div>

      <div class="sd-tab-panel is-active sd-prose" data-tab-panel="0">
        {{ product.description }}
      </div>

      <div class="sd-tab-panel sd-prose" data-tab-panel="1" hidden>
        <dl class="sd-spec-table">
          <div>
            <dt>{{ 'products.product.dimensions' | t }}</dt>
            <dd>{{ product.metafields.custom.dimensions.value | default: section.settings.default_dimensions_note }}</dd>
          </div>
          <div>
            <dt>{{ 'products.product.materials' | t }}</dt>
            <dd>{{ product.metafields.custom.materials.value | default: section.settings.default_materials_note }}</dd>
          </div>
          <div>
            <dt>Recommended Age / Grade</dt>
            <dd>{{ product.metafields.custom.age_group.value | default: 'Refer to product description or request specification sheet.' }}</dd>
          </div>
          <div>
            <dt>SKU</dt>
            <dd>{{ current_variant.sku | default: 'Made to Specification' }}</dd>
          </div>
        </dl>
      </div>

      <div class="sd-tab-panel sd-prose" data-tab-panel="2" hidden>
        {%- if product.metafields.custom.features != blank -%}
          {{ product.metafields.custom.features | metafield_tag }}
        {%- else -%}
          <p>Designed for institutional classroom and activity settings with child-conscious rounded edges and durable finishes. Contact our team for detailed CAD drawings or customization options.</p>
        {%- endif -%}
      </div>

      <div class="sd-tab-panel sd-prose" data-tab-panel="3" hidden>
        {%- if product.metafields.custom.additional_info != blank -%}
          {{ product.metafields.custom.additional_info | metafield_tag }}
        {%- else -%}
          <p>Available for bulk institutional orders, custom campus color themes, and turnkey classroom installations across India.</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_related_products -%}
      <div
        class="sd-pdp__related"
        data-product-recommendations
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4"
      >
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          <h2 class="sd-heading">{{ 'products.product.related_products' | t }}</h2>
          <div class="sd-product-grid sd-cols--4">
            {%- for rec in recommendations.products -%}
              {% render 'product-card', card_product: rec %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_recently_viewed -%}
      <div class="sd-pdp__recent" data-recently-viewed data-current-handle="{{ product.handle }}" hidden>
        <h2 class="sd-heading">{{ 'products.product.recently_viewed' | t }}</h2>
        <div class="sd-product-grid sd-cols--4" data-recently-viewed-grid></div>
      </div>
    {%- endif -%}
  </div>

  <div class="sd-pdp__mobile-bar">
    <div class="sd-pdp__mobile-bar-price">
      {%- if is_quote_only -%}
        <span>Custom Quote</span>
      {%- else -%}
        <strong>{{ current_variant.price | money }}</strong>
      {%- endif -%}
    </div>
    {%- if allow_direct_buy -%}
      <button type="button" class="sd-btn sd-btn--primary sd-btn--sm" data-mobile-sticky-add>
        {{ 'products.product.add_to_cart' | t }}
      </button>
    {%- else -%}
      <button type="button" class="sd-btn sd-btn--primary sd-btn--sm" data-open-quote data-product-title="{{ product.title | escape }}">
        {{ 'products.product.request_quote' | t }}
      </button>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Detail",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Dynamic Buy Now Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_related_products",
      "label": "Show Related Products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed",
      "label": "Show Recently Viewed Products",
      "default": true
    },
    {
      "type": "text",
      "id": "default_dimensions_note",
      "label": "Default Dimensions Fallback Note",
      "default": "Standard & custom sizes available upon request."
    },
    {
      "type": "text",
      "id": "default_materials_note",
      "label": "Default Materials Fallback Note",
      "default": "Engineered institutional-grade wood, powder-coated steel or safe play polymers."
    }
  ]
}
{% endschema %}
