<section
  id="section-{{ section.id }}"
  class="sd-hero sd-hero--banner"
  data-hero-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
  aria-roledescription="carousel"
  aria-label="Featured School Infrastructure Banners"
>
  <div class="sd-hero__banner-frame">
    <div class="sd-hero__slides">
      {%- for block in section.blocks -%}
        {%- liquid
          assign fallback_img = block.settings.image_fallback | default: 'sd-hero-classroom.jpg'
          if fallback_img == blank or fallback_img == 'none'
            case forloop.index
              when 2
                assign fallback_img = 'sd-hero-preschool.jpg'
              when 3
                assign fallback_img = 'sd-science-lab.jpg'
              when 4
                assign fallback_img = 'sd-outdoor-play.jpg'
              when 5
                assign fallback_img = 'sd-school-library.jpg'
              else
                assign fallback_img = 'sd-hero-classroom.jpg'
            endcase
          endif
          assign accent_color = block.settings.accent_color | default: '#007B36'
        -%}
        <div
          class="sd-hero__slide sd-hero__slide--banner{% if forloop.first %} is-active{% endif %}"
          data-hero-slide="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <picture class="sd-hero__media">
            {%- if block.settings.image_mobile != blank -%}
              <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 960 }}">
            {%- endif -%}
            {%- if block.settings.image_desktop != blank -%}
              <img
                src="{{ block.settings.image_desktop | image_url: width: 1920 }}"
                alt="{{ block.settings.heading | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if forloop.first %}fetchpriority="high"{% endif %}
              >
            {%- else -%}
              <img
                src="{{ fallback_img | asset_url }}"
                alt="{{ block.settings.heading | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if forloop.first %}fetchpriority="high"{% endif %}
              >
            {%- endif -%}
          </picture>

          <div
            class="sd-hero__scrim sd-hero__scrim--sunlit"
            style="--sd-scrim-strength: {{ block.settings.overlay_opacity | default: 92 | divided_by: 100.0 }};"
            aria-hidden="true"
          ></div>

          <div class="sd-container sd-hero__banner-body">
            <div class="sd-hero__banner-content">
              {%- if block.settings.eyebrow != blank -%}
                <div class="sd-hero__eyebrow-row">
                  <span class="sd-hero__eyebrow-bar" aria-hidden="true"></span>
                  <p class="sd-hero__eyebrow sd-hero__eyebrow--dark">
                    0{{ forloop.index }} / 0{{ section.blocks.size }} · {{ block.settings.eyebrow | escape }}
                  </p>
                </div>
              {%- endif -%}

              {%- if forloop.first -%}
                <h1 class="sd-hero__title sd-hero__title--banner">
                  {{ block.settings.heading | escape }}
                  {%- if block.settings.heading_script != blank -%}
                    <span class="sd-hero__script sd-hero__script--banner" style="color: {{ accent_color }};">
                      {{ block.settings.heading_script | escape }}
                    </span>
                  {%- endif -%}
                </h1>
              {%- else -%}
                <h2 class="sd-hero__title sd-hero__title--banner">
                  {{ block.settings.heading | escape }}
                  {%- if block.settings.heading_script != blank -%}
                    <span class="sd-hero__script sd-hero__script--banner" style="color: {{ accent_color }};">
                      {{ block.settings.heading_script | escape }}
                    </span>
                  {%- endif -%}
                </h2>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="sd-hero__desc sd-hero__desc--banner">{{ block.settings.description | escape }}</p>
              {%- endif -%}

              {%- if block.settings.highlight_stat != blank -%}
                <p class="sd-hero__stat">{{ block.settings.highlight_stat | escape }}</p>
              {%- endif -%}

              <div class="sd-hero__actions">
                {%- if block.settings.primary_label != blank -%}
                  <a href="{{ block.settings.primary_link | default: '/collections' }}" class="sd-btn sd-btn--primary sd-btn--lg">
                    {{ block.settings.primary_label | escape }}
                    {% render 'icon', name: 'arrow-right' %}
                  </a>
                {%- endif -%}
                {%- if block.settings.secondary_label != blank -%}
                  {%- if block.settings.secondary_opens_quote -%}
                    <button type="button" class="sd-btn sd-btn--outline sd-btn--lg sd-hero__quote-btn" data-open-quote>
                      {{ block.settings.secondary_label | escape }}
                    </button>
                  {%- else -%}
                    <a href="{{ block.settings.secondary_link | default: '/pages/request-quote' }}" class="sd-btn sd-btn--outline sd-btn--lg sd-hero__quote-btn">
                      {{ block.settings.secondary_label | escape }}
                    </a>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="sd-hero__banner-nav-wrap">
        <div class="sd-container">
          <div class="sd-hero__banner-dock">
            <button type="button" class="sd-hero__nav-btn" data-hero-prev aria-label="Previous hero banner">
              {% render 'icon', name: 'chevron-left' %}
            </button>

            <div class="sd-hero__tabs" role="tablist" aria-label="Select hero banner">
              {%- for block in section.blocks -%}
                <button
                  type="button"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  class="sd-hero__tab{% if forloop.first %} is-active{% endif %}"
                  data-hero-dot="{{ forloop.index0 }}"
                  aria-label="Banner 0{{ forloop.index }}: {{ block.settings.short_label | default: block.settings.heading | escape }}"
                >
                  <span class="sd-hero__tab-num">0{{ forloop.index }}</span>
                  <span class="sd-hero__tab-label">{{ block.settings.short_label | default: forloop.index | escape }}</span>
                </button>
              {%- endfor -%}
            </div>

            <button type="button" class="sd-hero__nav-btn" data-hero-next aria-label="Next hero banner">
              {% render 'icon', name: 'chevron-right' %}
            </button>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_wave_divider -%}
      <svg class="sd-hero__wave" aria-hidden="true" viewBox="0 0 1440 72" preserveAspectRatio="none">
        <path d="M0,44 C260,76 520,8 860,34 C1120,54 1300,18 1440,36 L1440,72 L0,72 Z" fill="{{ section.settings.wave_color | default: '#F5F1E6' }}" />
      </svg>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-Rotate Banners",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Banner Duration",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_wave_divider",
      "label": "Show Organic Bottom Wave Divider",
      "default": true
    },
    {
      "type": "color",
      "id": "wave_color",
      "label": "Bottom Wave Fill Color (Match Next Section)",
      "default": "#F5F1E6"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Banner Slide",
      "settings": [
        {
          "type": "text",
          "id": "short_label",
          "label": "Tab Selector Label",
          "default": "Classrooms"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Banner Photo"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Banner Photo (Optional)"
        },
        {
          "type": "select",
          "id": "image_fallback",
          "label": "Built-in Photography Fallback",
          "options": [
            { "value": "sd-hero-classroom.jpg", "label": "Modern K-12 Classroom" },
            { "value": "sd-hero-preschool.jpg", "label": "Preschool & Early Play" },
            { "value": "sd-science-lab.jpg", "label": "STEM & Science Lab" },
            { "value": "sd-outdoor-play.jpg", "label": "Outdoor Playground Park" },
            { "value": "sd-school-library.jpg", "label": "School Library & Campus Lounge" }
          ],
          "default": "sd-hero-classroom.jpg"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small Lead-in Text",
          "default": "School Furniture & Educational Infrastructure"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Headline Lead",
          "default": "Designing Better Spaces for"
        },
        {
          "type": "text",
          "id": "heading_script",
          "label": "Highlighted Script Word",
          "default": "Brighter Futures"
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "Script Accent Color",
          "default": "#007B36"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Supporting Banner Copy",
          "default": "Discover ergonomic classroom desks, contoured seating, modular storage and complete learning environments crafted for modern K-12 campuses."
        },
        {
          "type": "text",
          "id": "highlight_stat",
          "label": "Technical Spec Line",
          "default": "Grades 1–12 Ergonomic Sizing · FSC 18mm Birchwood"
        },
        {
          "type": "text",
          "id": "primary_label",
          "label": "Primary Button Label",
          "default": "Explore Classrooms"
        },
        {
          "type": "url",
          "id": "primary_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Secondary Button Label",
          "default": "Request a Quote"
        },
        {
          "type": "checkbox",
          "id": "secondary_opens_quote",
          "label": "Open Quick Quote Modal",
          "default": true
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary Button Link (if not opening quote popup)"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 65,
          "max": 98,
          "step": 1,
          "unit": "%",
          "label": "Sunlit Left Scrim Opacity",
          "default": 94
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
